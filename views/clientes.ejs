<%- include ('partials/header.ejs') %>
    <%- include ('partials/navbar.ejs') %>

    <div class="container">
        <div class="card">
            <div class="card-header">
                <h1>Cadastrar Clientes</h1>
            </div>
            <div class="card-body">
                <form action="/clientes/cadastrar" method="POST">
                    <label for="nome">Nome do Cliente:</label>
                    <input type="text" id="nome" name="nome" placeholder="Insira o nome do cliente" class="form-control" required>

                    <label for="cpf">CPF do Cliente:</label>
                    <input type="text" id="cpf" name="cpf" placeholder="Insira o cpf do cliente" class="form-control" required>
                    
                    <label for="telefone">Telefone do cliente:</label>
                    <input type="text" id="telefone" name="telefone" placeholder="Insira o telefone do cliente" class="form-control" required>

                    <label for="endereco">Endereço do cliente:</label>
                    <input type="text" name="endereco" id="endereco" placeholder="Insira o endereço do cliente" class="form-control" required>
                    <br>
                    <button type="submit" class="btn btn-primary">Cadastrar</button>
                    <button type="reset" class="btn btn-danger">Limpar</button>
                </form>
            </div>
        </div>
    </div>
    <br>
    <div class="container">
        <div class="card">
            <div class="card-header">
                <h1>Clientes</h1>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>Telefone</th>
                            <th>Endereço</th>
                            <th style="text-align: center;" colspan="2">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% clientes.forEach(cliente => { %>
                            <tr>
                                <td><%= cliente.id %></td>
                                <td><%= cliente.nome %></td>
                                <td><%= cliente.cpf %></td>
                                <td><%= cliente.telefone %></td>
                                <td><%= cliente.endereco %></td>
                                <td>
                                    <a href="/clientes/editar/<%=cliente.id%>" class="btn btn-warning">Editar</a>
                                </td>
                                <td>
                                    <a href="/clientes/excluir/<%=cliente.id%>" class="btn btn-danger" onclick="return confirm('Deseja mesmo excluir o cliente <%= cliente.nome %>')">Excluir</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<%- include ('partials/footer.ejs') %>