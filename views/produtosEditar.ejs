<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h1>EDITAR PRODUTO</h1>
            <hr>
        </div>
        <div class="card-body">
            <form action="/produtos/alterar" method="POST">                
                <input type="hidden" name="id" id="id" value="<%= produto.id %>">

                <label for="nome">Nome do produto</label>
                <input type="text" name="nome" id="nome" class="form-control" required>
                
                <label for="preco">Preço do produto</label>
                <input type="text" name="preco" id="preco" class="form-control" required>

                <label for="categoria">Categoria do produto</label>
                <input type="text" name="categoria" id="categoria" class="form-control" required>
                <br>
                <button type="submit" class="btn btn-warning" onclick="return confirm('Deseja mesmo alterar o produto <%= produto.nome %>?')">Alterar</button>
                <a href="/produtos">
                    <button type="button" class="btn btn-danger">Cancelar</button>
                </a>
            </form>
        </div>
    </div>
</div>

<%- include ('partials/footer.ejs') %>